# This URL is sent to ESP devices as callback_url.
# Use the LAN-reachable address of the Docker host, not localhost, when devices run on another machine.
SMART_WATERING_NODE_URL=http://192.0.2.10:8080
SMART_WATERING_PORT=8080
SMART_WATERING_PUBLIC_API_PORT=8081
SMART_WATERING_WORKER_IDLE_INTERVAL_SEC=1
SMART_WATERING_WORKER_RETRY_INTERVAL_SEC=5
SMART_WATERING_WORKER_MAX_WAIT_SEC=900
SMART_WATERING_SNAPSHOT_INTERVAL_SEC=300
SMART_WATERING_CLI_OPERATION_WAIT_TIMEOUT_SEC=900
SMART_WATERING_PUBLIC_API_JWT_SECRET=replace-with-a-long-random-secret
SMART_WATERING_PUBLIC_API_SESSION_TTL_SEC=3600
SMART_WATERING_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
SMART_WATERING_GOOGLE_ALLOWED_EMAILS=user@example.com
SMART_WATERING_GOOGLE_ALLOWED_DOMAINS=
# Prometheus on the Docker host. For another machine, use its LAN URL instead.
SMART_WATERING_PROMETHEUS_URL=http://host.docker.internal:9090
SMART_WATERING_DETECTION_WINDOW_MIN=5
SMART_WATERING_STATISTICS_TIMEZONE=Europe/Berlin
SMART_WATERING_CONSUMPTION_DROP_THRESHOLD_PERCENT=30
SMART_WATERING_CONSUMPTION_MEDIAN_DAYS=5
# Absolute host directory shared by the Android release runner and public-api container.
SMART_WATERING_ANDROID_RELEASES_DIR=/srv/smart-watering/releases
