FROM python:3.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    SMART_WATERING_DB_PATH=/data/smart_watering.db \
    TMPDIR=/data

WORKDIR /app

COPY smart_watering/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

COPY smart_watering ./smart_watering

RUN mkdir -p /data

VOLUME ["/data"]
EXPOSE 8080

ENTRYPOINT ["uvicorn", "smart_watering.callback_app.asgi:app"]
CMD ["--host", "0.0.0.0", "--port", "8080", "--no-access-log"]
